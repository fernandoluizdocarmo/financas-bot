{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron-report",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-tip",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron-cleanup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/init-webhook",
      "schedule": "5 0 * * *"
    }
  ]
}
