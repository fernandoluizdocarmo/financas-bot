# ─────────────────────────────────────────
#  Copie este arquivo para .env e preencha
#  NUNCA envie o .env para o GitHub!
# ─────────────────────────────────────────

# === OBRIGATÓRIO ===
# Token do BotFather (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxx

# Seu ID no Telegram (consulte @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# === SEU APP ===
# URL do app web que o bot vai divulgar
APP_URL=https://financas-glye.onrender.com

# Tipo do botão para abrir o app: 'webapp' (abre no Telegram), 'link' (abre no navegador) ou 'none' (remove o botão)
APP_BUTTON_TYPE=webapp

# === PIX (opcional, mas recomendado) ===
# Chave PIX do recebedor (CPF, e-mail, telefone ou chave aleatória)
PIX_KEY=seu-cpf@email.com.br

# Nome que aparece no PIX (até 25 caracteres, sem acentos)
PIX_NAME=Minhas Financas

# Cidade do recebedor (até 15 caracteres, sem acentos)
PIX_CITY=SAO PAULO

# Valor da assinatura em reais
PRICE=5.00

# === KEEP-ALIVE (recomendado para Render gratuito) ===
# URL pública deste bot no Render (ex: https://financas-bot.onrender.com)
# Deixe em branco se não usar o Render
SELF_URL=https://seu-bot.onrender.com

# Porta HTTP (o Render define automaticamente via variável PORT)
PORT=3000
